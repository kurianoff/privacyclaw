<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.privacyclaw.proxy</string>

    <!-- Launch the tray app through macOS 'open' so it gets a proper GUI session
         (direct exec via launchd does not receive window-server access).
         The poll loop keeps this job alive until privacyclaw exits, so launchd
         can restart it via KeepAlive if the app crashes or the user quits. -->
    <key>Program</key>
    <string>/bin/sh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>open -ga Privacyclaw; while pgrep -f "privacyclaw start --tray" &gt; /dev/null; do sleep 2; done</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/tmp/privacyclaw-proxy.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/privacyclaw-proxy.log</string>
</dict>
</plist>
