<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon (root): re-applies the claudovka pf anchor at boot.

  Installed by: claudovka postinstall script (or 'claudovka network-enable')
  Removed by:   claudovka uninstall / 'claudovka network-disable'

  At boot pf rules in anchors are not persistent by themselves; this daemon
  reloads /etc/pf.conf (which now contains the claudovka rdr-anchor and load
  anchor declarations) so the redirect rules are re-applied automatically.
  The anchor file check prevents a spurious pfctl error when the network
  proxy has never been enabled (anchor file not yet written).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudovka.pf</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <!-- Only reload if the anchor file is present (network proxy was enabled). -->
        <string>test -f /etc/pf.anchors/claudovka &amp;&amp; pfctl -a claudovka -F all 2&gt;/dev/null; test -f /etc/pf.anchors/claudovka &amp;&amp; pfctl -ef /etc/pf.conf 2&gt;/dev/null; true</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/claudovka-pf.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/claudovka-pf.log</string>
</dict>
</plist>
